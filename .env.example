# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git: never commit real keys (the repo is public).

# Claude API key for essay feedback. Without it, /api/feedback returns
# sample feedback so the app still works.
ANTHROPIC_API_KEY=

# Supabase (optional): accounts, My progress and Settings.
# Supabase dashboard -> Project Settings -> API Keys.
# Use the PUBLISHABLE key (starts with sb_publishable_), never the secret or
# service-role key. Leave both empty to keep accounts switched off.
# Example URL: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
